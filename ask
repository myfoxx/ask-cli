#!/bin/bash
# ask - Intelligent Ollama Wrapper
# Optimized for: qwen2.5-coder, deepseek-r1, llama3.1:8b, mistral
#
# Author: Myfox (https://github.com/myfoxx)
# License: MIT
# Made with ❤️ in Italy

INCLUDE_CONTEXT=false
ERROR_MODE=false
MANUAL_MODEL=""
VERBOSE=false
USE_GLOW=true
MAX_LINES=0
TIMEOUT=0
SAVE_OUTPUT=""
CACHE_ENABLED=false
APPEND_OUTPUT=false

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Config file
CONFIG_FILE="${HOME}/.askrc"
CACHE_DIR="${HOME}/.ask-cache"

# --- Config File Loading ---
load_config() {
    if [ -f "$CONFIG_FILE" ]; then
        if [ "$VERBOSE" = true ]; then
            echo "Loading config from: $CONFIG_FILE" >&2
        fi
        source "$CONFIG_FILE"
    fi
}

# --- Dependency Checks ---
check_dependencies() {
    if ! command -v ollama &> /dev/null; then
        echo "Error: 'ollama' is not installed or not in PATH." >&2
        exit 1
    fi

    if ! pgrep -x "ollama" > /dev/null && ! curl -s http://localhost:11434/api/tags >/dev/null; then
        echo "Warning: Ollama server does not seem to be running." >&2
        echo "Attempting to verify..." >&2
        echo "Please ensure 'ollama serve' is running." >&2
    fi
}

# --- List Available Models ---
list_models() {
    if ! command -v ollama &> /dev/null; then
        echo "Error: 'ollama' is not installed." >&2
        exit 1
    fi
    echo "Available models:"
    ollama list
    exit 0
}

# --- Cache Utilities ---
get_cache_path() {
    local prompt_hash=$(echo "$1" | sha256sum | cut -d' ' -f1)
    echo "${CACHE_DIR}/${prompt_hash}.cache"
}

read_cache() {
    local cache_file=$(get_cache_path "$1")
    if [ -f "$cache_file" ]; then
        cat "$cache_file"
        return 0
    fi
    return 1
}

write_cache() {
    mkdir -p "$CACHE_DIR"
    local cache_file=$(get_cache_path "$1")
    cat > "$cache_file"
}

clear_cache() {
    rm -rf "$CACHE_DIR"
    echo "Cache cleared."
    exit 0
}

# --- Truncate Input ---
truncate_input() {
    local input="$1"
    local max_lines="$2"

    if [ "$max_lines" -le 0 ]; then
        echo "$input"
        return
    fi

    local line_count=$(echo "$input" | wc -l)
    if [ "$line_count" -gt "$max_lines" ]; then
        echo "[Input truncated from $line_count to $max_lines lines]" >&2
        echo "$input" | head -n "$max_lines"
    else
        echo "$input"
    fi
}

# --- Model Selection Logic ---
select_model() {
    local q_lower
    q_lower=$(echo "$1" | tr '[:upper:]' '[:lower:]')
    
    # If in Error Mode, prefer a strong reasoning model
    if [ "$ERROR_MODE" = true ]; then
        echo "deepseek-r1:latest"
        return
    fi

    # Qwen2.5-coder: code, scripting, file operations
    if echo "$q_lower" | grep -qE "(script|code|command|bash|python|rust|go|javascript|convert|file|directory|sed|awk|grep|find|rsync|tar|zip|gzip|pdf|doc|docx|rename|chmod|chown|systemd|service|socket|timer|regex|parse|extract|compress|sql|docker|kubernetes|git|function|method|class|library|module|import|export)"; then
        echo "qwen2.5-coder:latest"
        return
    fi

    # DeepSeek-R1: reasoning, troubleshooting, security
    if echo "$q_lower" | grep -qE "(debug|problem|error|failed|fail|why|reason|explain|analyze|think|reasoning|troubleshoot|root cause|issue|fix|bug|crash|hang|slow|memory|leak|performance|security|vulnerability|exploit|attack|cve|permission|denied|access|forbidden)"; then
        echo "deepseek-r1:latest"
        return
    fi
    
    # Default fallback
    echo "llama3.1:8b"
}

# --- Model Availability Check & Fallback ---
get_available_model() {
    local target_model="$1"

    if ollama list | grep -q "^${target_model%%:*}"; then
        echo "$target_model"
        return
    fi

    echo -e "${YELLOW}Warning: Model '$target_model' not found locally.${NC}" >&2
    local fallbacks=("llama3.1:8b" "mistral:latest" "gemma:2b" "qwen2.5:0.5b")
    for fb in "${fallbacks[@]}"; do
        if ollama list | grep -q "^${fb%%:*}"; then
            echo -e "${BLUE}Falling back to: $fb${NC}" >&2
            echo "$fb"
            return
        fi
    done

    echo -e "${RED}Error: No compatible model found locally.${NC}" >&2
    exit 1
}

# --- Main Script ---

load_config
check_dependencies

while getopts "cm:vheRl:t:s:a-:" opt; do
    case $opt in
        c) INCLUDE_CONTEXT=true ;;
        e) ERROR_MODE=true ;;
        m) MANUAL_MODEL="$OPTARG" ;;
        v) VERBOSE=true ;;
        R) USE_GLOW=false ;;
        l) MAX_LINES="$OPTARG" ;;
        t) TIMEOUT="$OPTARG" ;;
        s) SAVE_OUTPUT="$OPTARG"; CACHE_ENABLED=true ;;
        a) APPEND_OUTPUT=true ;;
        -)
            case "${OPTARG}" in
                list-models) list_models ;;
                cache) CACHE_ENABLED=true ;;
                clear-cache) clear_cache ;;
                help)
                    echo "Usage: ask [OPTIONS] <question or command>"
                    echo ""
                    echo "Options:"
                    echo "  -c              Include current directory context"
                    echo "  -e              Error/Debug Mode (Pipe or Wrapper)"
                    echo "  -m MODEL        Force specific model"
                    echo "  -v              Verbose details"
                    echo "  -R              Raw output (disable glow formatting)"
                    echo "  -l LINES        Max lines to include from input (0=unlimited)"
                    echo "  -t TIMEOUT      Timeout in seconds (0=no timeout)"
                    echo "  -s FILE         Save output to file"
                    echo "  -a              Append to file (with -s)"
                    echo "  --cache         Enable cache for this query"
                    echo "  --list-models   List available Ollama models"
                    echo "  --clear-cache   Clear all cached responses"
                    echo "  --help          Show this help message"
                    echo ""
                    echo "Examples:"
                    echo "  ask 'how to install rust?'"
                    echo "  ask -c 'explain this project'"
                    echo "  ask -e make build"
                    echo "  cat logfile | ask -e 'what went wrong?'"
                    echo "  ask -l 50 -e make install  (max 50 lines of error)"
                    echo "  ask -s output.txt 'explain ansible'"
                    exit 0
                    ;;
                *)
                    echo "Invalid long option: --${OPTARG}" >&2
                    exit 1
                    ;;
            esac
            ;;
        h)
            echo "Usage: ask [OPTIONS] <question or command>"
            echo "Use 'ask --help' for full documentation"
            exit 0
            ;;
        \?) echo "Invalid option: -$OPTARG" >&2; exit 1 ;;
    esac
done

shift $((OPTIND-1))

# Check Input Sources
PIPED_INPUT=""
COMMAND_TO_RUN=""
QUESTION=""

if [ ! -t 0 ]; then
    PIPED_INPUT=$(cat)
fi

if [ "$ERROR_MODE" = true ] && [ -n "$*" ]; then
    if [ -z "$PIPED_INPUT" ]; then
        COMMAND_TO_RUN="$*"
    else
        QUESTION="$*"
    fi
else
    QUESTION="$*"
fi

if [ -n "$COMMAND_TO_RUN" ]; then
    if [ "$VERBOSE" = true ]; then
        echo "[Running command: $COMMAND_TO_RUN]" >&2
    fi
    # Create temp file for output capture
    OUTPUT_FILE=$(mktemp)
    # Execute preserving output
    eval "$COMMAND_TO_RUN" > "$OUTPUT_FILE" 2>&1
    EXIT_CODE=$?
    
    if [ $EXIT_CODE -eq 0 ]; then
        cat "$OUTPUT_FILE"
        rm "$OUTPUT_FILE"
        exit 0
    else
        cat "$OUTPUT_FILE"
        PIPED_INPUT=$(cat "$OUTPUT_FILE")
        rm "$OUTPUT_FILE"
        QUESTION="The command '$COMMAND_TO_RUN' failed (Exit code: $EXIT_CODE). Analyze the output and explain the error."
        echo "" >&2
        echo "--- ASK ANALYSIS ---" >&2
    fi
fi

if [ -z "$QUESTION" ] && [ -z "$PIPED_INPUT" ]; then
    if [ "$ERROR_MODE" = true ]; then
        echo "Error: -e requires a command to run or piped input."
    else
        echo "Error: no question specified."
    fi
    exit 1
fi

if [ -n "$PIPED_INPUT" ] && [ -z "$QUESTION" ]; then
    QUESTION="Analyze the following output/error and explain the problem:"
fi

# Truncate input if max lines specified
if [ "$MAX_LINES" -gt 0 ]; then
    PIPED_INPUT=$(truncate_input "$PIPED_INPUT" "$MAX_LINES")
fi

# --- Model Target ---
if [ -n "$MANUAL_MODEL" ]; then
    case "$MANUAL_MODEL" in
        qwen*|coder) TARGET_MODEL="qwen2.5-coder:latest" ;;
        deep*|r1) TARGET_MODEL="deepseek-r1:latest" ;;
        llama*|llama3.1) TARGET_MODEL="llama3.1:8b" ;;
        mistral*) TARGET_MODEL="mistral:latest" ;;
        *) TARGET_MODEL="$MANUAL_MODEL" ;;
    esac
else
    TARGET_MODEL=$(select_model "$QUESTION")
fi

MODEL=$(get_available_model "$TARGET_MODEL")

# --- Dynamic System Context ---
OS_INFO=$(uname -sr 2>/dev/null || echo "Linux Unknown")
SHELL_INFO="${SHELL##*/}"

BASE_SYSTEM_PROMPT="You are an expert operating on ${OS_INFO}, shell: ${SHELL_INFO}.
Security: IF THE REQUESTED COMMAND IS DESTRUCTIVE (rm -rf, dd, mkfs, etc.), EXPLICITLY WARN THE USER BEFORE PROPOSING IT."

if [[ "$MODEL" == *"coder"* ]]; then
    SYSTEM_CONTEXT="${BASE_SYSTEM_PROMPT}
Role: Senior Dev/Sysadmin. CLI only.
Response: direct command or fix. Zero superfluous theoretical explanations.
Format: command ready-to-run if possible."
elif [[ "$MODEL" == *"deepseek"* ]]; then
    SYSTEM_CONTEXT="${BASE_SYSTEM_PROMPT}
Role: Security Researcher / Senior Sysadmin.
Technical reasoning required: root cause analysis of the error.
Focus: logical debug, missing dependencies, permission issues."
elif [[ "$MODEL" == *"mistral"* ]]; then
    SYSTEM_CONTEXT="${BASE_SYSTEM_PROMPT}
Role: Power User. CLI-first approach.
Output: practical and actionable solution."
else
    SYSTEM_CONTEXT="${BASE_SYSTEM_PROMPT}
Role: Professional User.
Preference: CLI-first. Direct and technical communication."
fi

# --- Prompt Construction ---
PROMPT="${SYSTEM_CONTEXT}

"

if [ "$INCLUDE_CONTEXT" = true ]; then
    PROMPT+="[Current Directory Context]\n"
    PROMPT+="Path: $(pwd)\n"
    
    if command -v eza &>/dev/null; then
        FILE_LIST=$(eza --oneline --color=never | head -n 20)
    elif command -v exa &>/dev/null; then
        FILE_LIST=$(exa --oneline --color=never | head -n 20)
    else
        FILE_LIST=$(ls -1 | head -n 20)
    fi
    
    PROMPT+="Files:\n${FILE_LIST}\n\n"
fi

if [ -n "$PIPED_INPUT" ]; then
    PROMPT+="[INPUT/LOG TO ANALYZE]\n"
    PROMPT+="'''\n"
    PROMPT+="${PIPED_INPUT}\n"
    PROMPT+="'''\n\n"
fi

PROMPT+="Request: ${QUESTION}"

if [ "$VERBOSE" = true ]; then
    echo "--- Debug Info ---" >&2
    echo "Model: $MODEL" >&2
    echo "OS: $OS_INFO, Shell: $SHELL_INFO" >&2
    [ -n "$PIPED_INPUT" ] && echo "Input: $(echo "$PIPED_INPUT" | wc -l) lines captured" >&2
    [ "$CACHE_ENABLED" = true ] && echo "Cache: enabled" >&2
    [ "$MAX_LINES" -gt 0 ] && echo "Max input lines: $MAX_LINES" >&2
    [ "$TIMEOUT" -gt 0 ] && echo "Timeout: ${TIMEOUT}s" >&2
    [ -n "$SAVE_OUTPUT" ] && echo "Output file: $SAVE_OUTPUT" >&2
    echo "------------------" >&2
fi

# Check cache first
if [ "$CACHE_ENABLED" = true ]; then
    if cached_result=$(read_cache "$PROMPT" 2>/dev/null); then
        if [ "$VERBOSE" = true ]; then
            echo "Cache hit!" >&2
        fi
        OUTPUT="$cached_result"
    else
        # Execute with optional timeout
        if [ "$TIMEOUT" -gt 0 ]; then
            OUTPUT=$(timeout "$TIMEOUT" ollama run "$MODEL" "$PROMPT" 2>&1)
            EXIT_CODE=$?
            if [ $EXIT_CODE -eq 124 ]; then
                OUTPUT="Error: Request timed out after ${TIMEOUT} seconds."
            fi
        else
            OUTPUT=$(ollama run "$MODEL" "$PROMPT")
        fi
        # Cache the result
        echo "$OUTPUT" | write_cache "$PROMPT"
    fi
else
    # Execute with optional timeout
    if [ "$TIMEOUT" -gt 0 ]; then
        OUTPUT=$(timeout "$TIMEOUT" ollama run "$MODEL" "$PROMPT" 2>&1)
        EXIT_CODE=$?
        if [ $EXIT_CODE -eq 124 ]; then
            OUTPUT="Error: Request timed out after ${TIMEOUT} seconds."
        fi
    else
        OUTPUT=$(ollama run "$MODEL" "$PROMPT")
    fi
fi

# Format and output the response
if [ "$USE_GLOW" = true ] && command -v glow &>/dev/null; then
    FORMATTED_OUTPUT=$(echo "$OUTPUT" | glow -)
else
    FORMATTED_OUTPUT="$OUTPUT"
fi

# Save to file if specified
if [ -n "$SAVE_OUTPUT" ]; then
    if [ "$APPEND_OUTPUT" = true ]; then
        echo "$FORMATTED_OUTPUT" >> "$SAVE_OUTPUT"
        if [ "$VERBOSE" = true ]; then
            echo "Output appended to: $SAVE_OUTPUT" >&2
        fi
    else
        echo "$FORMATTED_OUTPUT" > "$SAVE_OUTPUT"
        if [ "$VERBOSE" = true ]; then
            echo "Output saved to: $SAVE_OUTPUT" >&2
        fi
    fi
else
    echo "$FORMATTED_OUTPUT"
fi
