# ASK Configuration File
# Location: ~/.askrc
# This file is sourced by the ask script to set defaults

# Default flags
# VERBOSE=true                    # Always show debug info
# USE_GLOW=false                  # Disable glow formatting by default
# INCLUDE_CONTEXT=false           # Don't include directory context by default
# CACHE_ENABLED=true              # Enable cache by default

# Default limits
# MAX_LINES=100                   # Truncate input at 100 lines by default
# TIMEOUT=120                     # 2-minute timeout by default

# Output options
# SAVE_OUTPUT=""                  # Save responses to file (append to ~/.ask-history)
# APPEND_OUTPUT=true              # Always append instead of overwrite

# Custom model aliases
# Uncomment to use custom models
# ASK_CODER_MODEL="qwen2.5-coder:latest"
# ASK_REASONING_MODEL="deepseek-r1:latest"
# ASK_DEFAULT_MODEL="llama3.1:8b"

# Custom keywords for model routing
# You can add your own keywords to trigger specific models
# Note: The base keywords are still checked, these are additions
# CUSTOM_CODER_KEYWORDS="tensorflow|pytorch|cuda"
# CUSTOM_REASONING_KEYWORDS="proof|theorem|statistical"

# Color preferences
# Uncomment to customize colors
# RED='\033[0;31m'
# GREEN='\033[0;32m'
# YELLOW='\033[1;33m'
# BLUE='\033[0;34m'
# NC='\033[0m'

# Cache settings
# CACHE_DIR="${HOME}/.ask-cache"  # Location of cache
# CACHE_TTL=604800                # Cache time-to-live in seconds (7 days)

# Example: Always save responses to history
# SAVE_OUTPUT="${HOME}/.ask-history"
# APPEND_OUTPUT=true

# Example: Conservative settings (small input, long timeout)
# MAX_LINES=50
# TIMEOUT=300
# VERBOSE=true
